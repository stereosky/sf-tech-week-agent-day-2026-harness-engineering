# Copy to .env and edit.

# Lenses Community Edition needs you to accept its EULA: https://lenses.io/legals/eula
ACCEPT_EULA=false

# The model. It must support tool calling in Ollama.
MODEL=qwen3.5:2b

# Where Ollama runs.
#
# Linux and Windows: leave these two lines as they are. Ollama runs in Docker Compose.
#
# macOS: Docker has no access to the Apple GPU, so Ollama in a container is about
# 5x slower. Install the Ollama app, run `ollama pull qwen3.5:2b`, then use:
#   COMPOSE_PROFILES=
#   OLLAMA_URL=http://host.docker.internal:11434
COMPOSE_PROFILES=ollama
OLLAMA_URL=http://ollama:11434

# Windows (WSL2 with the repo on the Windows drive): set true if saving a file
# does not reload the harness.
WATCHFILES_FORCE_POLLING=false

# Host ports, in case something else already uses them.
# HQ_PORT=9991
# KAFKA_PORT=9092
# HARNESS_PORT=8080
# OPENCODE_PORT=4096
